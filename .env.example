# =============================================================================
# faisalaffan-design-system — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# Runtime
ENV=development
PORT=8080

# Redis (used by flash-sale, inventory, checkout, promo, etc.)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Security
HMAC_SECRET=change-me-in-production

# Service Ports (override defaults)
# PORT_INVENTORY=8100
# PORT_GEO=8101
# PORT_FLASH_SALE=8102
# PORT_CHECKOUT=8103
# PORT_PROMO=8104
# PORT_DISPATCH=8105
# PORT_ETA=8106
# PORT_SEARCH=8107
# PORT_TRACKING=8108
# PORT_PRICING=8109
# PORT_FORECASTING=8110

# External APIs (q-commerce services)
# OSRM_BASE_URL=https://router.project-osrm.org
# WEATHER_API_KEY=
# POSTGRES_DSN=postgres://user:pass@localhost:5432/qcommerce
